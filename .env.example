# Copy to .env.local and fill in. Never commit real values.

# Google Cloud project that holds the StormHacks Gemini credits
GOOGLE_CLOUD_PROJECT=
# e.g. "global" (preview models) or a region like "us-central1"
GOOGLE_CLOUD_LOCATION=global
# Service-account key JSON (role: Vertex AI User), pasted as ONE line
GOOGLE_SERVICE_ACCOUNT_JSON=

# 1 = fake data, no AI calls, no cost (see fake-data/README.md). 0 = real API.
# In development the "Fake data" badge on any page overrides this without a restart.
NEXT_PUBLIC_MOCK_AI=0
