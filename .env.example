# Copy to .env.local and fill in. Never commit real values.

# Google Cloud project that holds the StormHacks Gemini credits
GOOGLE_CLOUD_PROJECT=
# e.g. "global" (preview models) or a region like "us-central1"
GOOGLE_CLOUD_LOCATION=global
# Service-account key JSON (role: Vertex AI User), pasted as ONE line.
# Paste it bare or in 'single quotes'; double quotes break it. Check with: npm run check:vertex
GOOGLE_SERVICE_ACCOUNT_JSON=

# 1 = mock mode: AI calls are answered from the saved KALLAX manual (no AI calls, no cost). 0 = real API.
# Read at build time: restart `npm run dev`, or rebuild, after changing it.
NEXT_PUBLIC_MOCK_AI=0
